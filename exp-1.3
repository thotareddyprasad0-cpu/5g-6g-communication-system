clc;
clear;
close all;

%% Parameters
Ps = 1;                         % Signal Power (W)
Pn = [0.1 0.05 0.01];           % Noise Power (W)
Users = 1:3;                    % Number of Users

%% SNR Calculation
SNR = 10 * log10(Ps ./ Pn);     % SNR in dB

%% Display Results
disp('User   Noise Power (W)   SNR (dB)');
disp([Users' Pn' SNR']);

%% Plot SNR
figure;

bar(Users, SNR);

xlabel('Users');
ylabel('SNR (dB)');
title('Signal-to-Noise Ratio of FDMA Users');

grid on;

xticks(Users);
xticklabels({'User 1','User 2','User 3'});
