clc;
clear;
close all;

%% TDMA Parameters
FrameTime = 4.615;                    % Frame time (ms)
Slots = 8;                            % Number of time slots
SlotDuration = FrameTime / Slots;     % Duration of each slot (ms)

t = 0:SlotDuration:FrameTime;

%% Plot TDMA Time Slot Structure
figure;

subplot(2,1,1);
stem(t, ones(size(t)), 'filled');

title('TDMA Time Slot Structure');
xlabel('Time (ms)');
ylabel('Slot Level');
grid on;

%% Continuous View of Slot Allocation
subplot(2,1,2);
plot(t, ones(size(t)), '-o', 'LineWidth', 1.5);

title('Continuous View of Slot Allocation');
xlabel('Time (ms)');
ylabel('Slot Presence');
grid on;
